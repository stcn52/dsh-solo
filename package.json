{
  "name": "dsh-solo",
  "version": "0.2.0",
  "description": "Live operation view for DeepSeek Harness: every tool call the agent makes (terminal, browser, file, subagent) folded from the session log, with status, duration, input and output — no self-reporting.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "solo",
    "agent",
    "task"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  }
}
